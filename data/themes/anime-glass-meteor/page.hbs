{{!< default}}
{{!-- 独立页面：关于我、友链、工具箱等，沿用文章版式但精简元信息 --}}

{{#post}}
<article class="ag-article ag-article-page ag-glass ag-post-reading">
    {{#if @page.show_title_and_feature_image}}
        <header class="ag-article-head">
            <div class="ag-article-intro">
                <h1 class="ag-article-title">{{title}}</h1>
                {{#if custom_excerpt}}<p class="ag-article-excerpt">{{custom_excerpt}}</p>{{/if}}
            </div>
            {{#if feature_image}}
                <figure class="ag-article-cover">
                    <img src="{{img_url feature_image size="xl"}}"
                         srcset="{{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                         sizes="(min-width: 1240px) 1100px, (min-width: 768px) 84vw, 89vw"
                         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager" />
                    {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
                </figure>
            {{/if}}
        </header>
    {{/if}}

    <div class="ag-article-body">
        <section class="ag-content gh-content" id="ag-content">
            {{content}}
        </section>
        <aside class="ag-toc ag-glass-soft" id="ag-toc" hidden>
            <b>本页目录</b>
        </aside>
    </div>
</article>
{{/post}}
