{
    "name": "anime-glass-meteor",
    "description": "Anime-inspired glassmorphism Ghost theme (customized from Casper)",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22.12.0"
    },
    "license": "MIT",
    "author": {
        "name": "Serendipity",
        "email": "admin@example.com"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Anime",
            "Minimal"
        ]
    },
    "keywords": [
        "ghost-theme",
        "anime",
        "glassmorphism"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "color_scheme": {
                "type": "select",
                "options": [
                    "Light",
                    "Dark",
                    "Auto"
                ],
                "default": "Light"
            },
            "hero_title": {
                "type": "text",
                "default": "在雾里看代码，也在雾里看风景"
            },
            "hero_badge": {
                "type": "text",
                "default": "Serendipity · Journal"
            },
            "gallery_title": {
                "type": "text",
                "default": "Moments"
            }
        }
    }
}
