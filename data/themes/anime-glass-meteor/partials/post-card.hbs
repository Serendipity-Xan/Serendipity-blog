{{!-- 文章卡片：毛玻璃底 + 圆角封面 + 标签胶囊。
     在首页网格、标签页、阅读更多里共用；参数来自当前 post 上下文。 --}}
<article class="ag-card ag-glass{{#unless feature_image}} is-text-only{{/unless}} {{post_class}}">
    <a class="ag-card-link" href="{{url}}">
        {{#if feature_image}}
            <div class="ag-card-cover">
                <img src="{{img_url feature_image size="m"}}"
                     srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
                     sizes="(min-width: 1100px) 380px, (min-width: 700px) 45vw, 92vw"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     loading="lazy" />
            </div>
        {{/if}}
        <div class="ag-card-body">
            <div class="ag-post-card-tags">
                {{#primary_tag}}<span class="ag-chip">{{name}}</span>{{/primary_tag}}
            </div>
            <h3 class="ag-card-title">{{title}}</h3>
            <p class="ag-card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="44"}}{{/if}}</p>
            <div class="ag-card-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
                <span class="ag-dot"></span>
                <span>{{reading_time minute="1 分钟阅读" minutes="% 分钟阅读"}}</span>
            </div>
        </div>
    </a>
</article>
