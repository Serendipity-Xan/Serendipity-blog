{{!< default}}
{{#contentFor "ag-page-assets"}}
    <link rel="stylesheet" href="{{asset "css/pearl-links.css"}}" />
    <script src="{{asset "js/pearl-links.js"}}" defer></script>
{{/contentFor}}

{{#post}}
<section class="ag-links-shell">
    <div class="ag-graph-stage" id="ag-graph-stage" role="region" aria-label="友链关系图谱">
        <canvas class="ag-graph-canvas" id="ag-graph-canvas" aria-hidden="true"></canvas>

        <div class="ag-graph-hud">
            <h1 id="ag-graph-hud-title">{{title}}</h1>
            <p id="ag-graph-hud-sub">星月图谱：中心明月串联友链 · 发光圆点为分类 · 悬停/点击星星显现站点图标</p>
        </div>

        <button type="button" class="ag-graph-btn ag-const-back-btn" id="ag-const-back" hidden>&lt; 返回深空</button>

        <div class="ag-graph-actions">
            <div class="ag-mode-switch" role="tablist" aria-label="友链展示模式">
                <button type="button" class="ag-mode-tab" role="tab" aria-selected="false" data-links-mode="constellation">✦ 星座星群</button>
                <button type="button" class="ag-mode-tab is-active" role="tab" aria-selected="true" data-links-mode="network">☽ 星月图谱</button>
            </div>
            <button type="button" class="ag-graph-btn" id="ag-const-all" hidden>✦ 展开全部</button>
            <button type="button" class="ag-graph-btn" id="ag-graph-reset">重置图谱</button>
        </div>

        <div class="ag-const-overlay" id="ag-const-overlay" hidden></div>
        <svg class="ag-graph-svg" id="ag-graph-svg"></svg>

        <aside class="ag-graph-card" id="ag-graph-card" hidden>
            <div class="ag-graph-card-head">
                <img class="ag-graph-card-icon" id="ag-graph-card-icon" hidden alt="" decoding="async" />
                <h2 class="ag-graph-card-title" id="ag-graph-card-title"></h2>
                <button type="button" class="ag-graph-card-close" id="ag-graph-card-close" aria-label="关闭">×</button>
            </div>
            <div class="ag-graph-card-host" id="ag-graph-card-host"></div>
            <p class="ag-graph-card-desc" id="ag-graph-card-desc"></p>
            <div class="ag-graph-card-tags" id="ag-graph-card-tags"></div>
            <a class="ag-graph-card-visit" id="ag-graph-card-visit" href="#" target="_blank" rel="noopener">访问站点 →</a>
        </aside>
    </div>

    <div id="ag-links-records" hidden>
        <a class="ag-friend" href="https://ghost.org/" data-tags="开源生态" data-icon="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='16' fill='%2315171a'/%3E%3Cpath d='M9 11h6v3H9zm8 0h6v3h-6zM9 16h14v3H9zm0 5h9v3H9z' fill='%23fff'/%3E%3C/svg%3E">
            <b>Ghost 官方</b><em>本站使用的博客系统</em>
        </a>
        <a class="ag-friend" href="https://www.tommywutong.cn/" data-tags="个人博客,前端开发" data-icon="✦">
            <b>Tommy 的博客</b><em>排版精致的 iOS / 前端笔记</em>
        </a>
        <a class="ag-friend" href="https://bai-blog-liart.vercel.app/" data-tags="个人博客" data-icon="❄">
            <b>白的小站</b><em>毛玻璃风格的二次元博客</em>
        </a>
        <a class="ag-friend" href="https://developer.mozilla.org/zh-CN/" data-tags="前端开发" data-icon="M">
            <b>MDN</b><em>查前端 API 的第一站</em>
        </a>
        <a class="ag-friend" href="https://go.dev/doc/" data-tags="后端架构" data-icon="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='16' fill='%2300ADD8'/%3E%3Ctext x='16' y='21' font-size='13' font-family='monospace' font-weight='700' fill='%23fff' text-anchor='middle'%3EGO%3C/text%3E%3C/svg%3E">
            <b>Go 文档</b><em>写 Go 时最常打开的一页</em>
        </a>
        <a class="ag-friend" href="https://openim.io/" data-tags="后端架构,开源生态">
            <b>OpenIM</b><em>开源即时通讯框架</em>
        </a>
    </div>

    {{#if html}}
        <div class="ag-links-note gh-content">{{content}}</div>
    {{/if}}
</section>
{{/post}}
