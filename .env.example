# Public URL of your blog (no trailing slash)
PUBLIC_URL=http://localhost:8082

# Host bind IP and port for blog-gateway
GATEWAY_BIND_IP=0.0.0.0
GATEWAY_PORT=8082

# MySQL credentials (change these before deploying!)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change_me_ghost_password

# Tune down to 32M on 1C1G VPS
MYSQL_BUFFER_POOL_SIZE=64M

# Ghost Content API Key (create a custom integration in Ghost /ghost/ -> Integrations, or query api_keys)
GHOST_CONTENT_KEY=

# Optional image overrides (e.g. registry mirrors in mainland China)
GHOST_IMAGE=ghost:6-alpine
MYSQL_IMAGE=mysql:8.0
